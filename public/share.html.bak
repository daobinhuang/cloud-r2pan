<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>cloud-r2pan</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 24px; color: #fff; overflow: hidden; position: relative;
  background: linear-gradient(160deg, #0b1026 0%, #1a1240 45%, #2a1045 100%);
  -webkit-tap-highlight-color: transparent;
}
.orb { position: fixed; border-radius: 50%; filter: blur(90px); opacity: .5; pointer-events: none; animation: drift 18s ease-in-out infinite alternate; }
.o1 { width: 46vmax; height: 46vmax; background: #38bdf8; top: -18%; left: -14%; }
.o2 { width: 40vmax; height: 40vmax; background: #8b5cf6; bottom: -20%; right: -10%; animation-delay: -6s; }
.o3 { width: 30vmax; height: 30vmax; background: #ec4899; top: 55%; left: 8%; animation-delay: -12s; opacity: .35; }
@keyframes drift { from { transform: translate(0, 0) scale(1); } to { transform: translate(6vw, -5vh) scale(1.12); } }

.card {
  position: relative; width: 100%; max-width: 440px;
  padding: 48px 36px 40px; border-radius: 36px; text-align: center;
  background: linear-gradient(145deg, rgba(255,255,255,.16), rgba(255,255,255,.05));
  backdrop-filter: blur(32px) saturate(180%); -webkit-backdrop-filter: blur(32px) saturate(180%);
  border: 1px solid rgba(255,255,255,.28);
  box-shadow: 0 24px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.35);
  animation: rise .65s cubic-bezier(.22,1.2,.36,1) both;
}
@keyframes rise { from { opacity: 0; transform: translateY(28px) scale(.95); } to { opacity: 1; transform: none; } }

.file-icon {
  width: 104px; height: 104px; margin: 0 auto 24px; border-radius: 30px;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(145deg, rgba(255,255,255,.28), rgba(255,255,255,.08));
  border: 1px solid rgba(255,255,255,.32);
  box-shadow: inset 0 2px 0 rgba(255,255,255,.45), 0 14px 34px rgba(0,0,0,.35);
  position: relative; overflow: hidden;
}
.file-icon::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.35) 48%, transparent 62%);
  transform: translateX(-120%); animation: shine 4.5s ease-in-out infinite;
}
@keyframes shine { 0%, 60% { transform: translateX(-120%); } 85%, 100% { transform: translateX(120%); } }
.file-icon .ext { font-size: 26px; font-weight: 800; letter-spacing: -.02em; text-shadow: 0 2px 8px rgba(0,0,0,.25); }

h1 { font-size: 21px; font-weight: 700; letter-spacing: -.02em; word-break: break-all; line-height: 1.35; }
.meta { margin-top: 10px; font-size: 14px; color: rgba(255,255,255,.72); display: flex; gap: 8px; justify-content: center; align-items: center; flex-wrap: wrap; }
.meta .dot { width: 3px; height: 3px; border-radius: 50%; background: rgba(255,255,255,.4); }

.stats { display: flex; gap: 10px; margin-top: 26px; }
.stat {
  flex: 1; padding: 14px 8px; border-radius: 20px;
  background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14);
}
.stat .v { font-size: 20px; font-weight: 700; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
.stat .k { margin-top: 3px; font-size: 12px; color: rgba(255,255,255,.6); }

.btn {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; margin-top: 28px; padding: 17px; border: none; border-radius: 22px;
  font-size: 17px; font-weight: 650; letter-spacing: -.01em; color: #fff; cursor: pointer;
  background: linear-gradient(180deg, #3d9bff, #0a7cff);
  box-shadow: 0 12px 30px rgba(10,124,255,.42), inset 0 1px 0 rgba(255,255,255,.35);
  transition: transform .15s cubic-bezier(.22,1.2,.36,1), box-shadow .2s;
  text-decoration: none; -webkit-user-select: none; user-select: none;
}
.btn:hover { transform: translateY(-1px) scale(1.01); }
.btn:active { transform: scale(.97); }
.btn svg { width: 19px; height: 19px; }

.hint { margin-top: 14px; font-size: 12.5px; color: rgba(255,255,255,.55); line-height: 1.6; }

.warn { margin-top: 18px; padding: 13px 16px; border-radius: 16px; font-size: 13.5px; line-height: 1.55;
  background: rgba(255,159,10,.14); border: 1px solid rgba(255,159,10,.35); color: #ffd9a0; }

.loading { padding: 80px 0; text-align: center; }
.spinner { width: 34px; height: 34px; margin: 0 auto 16px; border-radius: 50%;
  border: 3px solid rgba(255,255,255,.18); border-top-color: #fff; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.brand { position: fixed; bottom: max(22px, env(safe-area-inset-bottom)); left: 0; right: 0; text-align: center;
  font-size: 13px; color: rgba(255,255,255,.4); letter-spacing: .08em; }
.brand b { font-weight: 650; }
.lang-btn { margin-left: 10px; padding: 4px 13px; border-radius: 11px; border: 1px solid rgba(255,255,255,.22);
  background: rgba(255,255,255,.1); color: rgba(255,255,255,.75); font-size: 12px; font-family: inherit;
  letter-spacing: 0; cursor: pointer; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  transition: all .2s; vertical-align: 1px; }
.lang-btn:hover { background: rgba(255,255,255,.2); color: #fff; }

/* GitHub Octocat 悬浮按钮 */
.octo-float {
  position: fixed;
  right: max(16px, env(safe-area-inset-right));
  bottom: max(20px, env(safe-area-inset-bottom));
  width: 44px; height: 44px;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(255,255,255,.2), rgba(255,255,255,.05));
  border: 1px solid rgba(255,255,255,.28);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; text-decoration: none; z-index: 50;
  box-shadow: 0 8px 22px rgba(0,0,0,.35);
  transition: transform .25s cubic-bezier(.22,1.2,.36,1), box-shadow .25s;
}
.octo-float:hover { transform: translateY(-3px) scale(1.08); box-shadow: 0 12px 30px rgba(0,0,0,.45); }
.octo-float svg { width: 22px; height: 22px; color: #fff; }

.pw { margin-top: 6px; }
.pw input {
  width: 100%; margin-top: 22px; padding: 16px; border-radius: 16px; text-align: center;
  font-size: 17px; font-family: inherit; color: #fff; outline: none;
  background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.28);
}
.pw input::placeholder { color: rgba(255,255,255,.45); }
.pw input:focus { border-color: #3d9bff; }
.pw .err { margin-top: 10px; font-size: 13px; color: #ff8480; min-height: 18px; }
.pw .pw-hint { margin-top: 12px; font-size: 12.5px; color: rgba(255,255,255,.55); }
.pw.shake input { animation: shake .5s; }
@keyframes shake { 0%,100%{transform:translateX(0)} 20%,60%{transform:translateX(-8px)} 40%,80%{transform:translateX(8px)} }

/* Turnstile */
.ts-wrap {
  width: 100%; margin-top: 22px; display: flex; justify-content: center;
}
.ts-wrap div, .ts-wrap iframe { border-radius: 14px !important; }
.ts-passed {
  width: 100%; margin-top: 22px; padding: 14px; border-radius: 16px;
  background: rgba(110,231,183,.15); border: 1px solid rgba(110,231,183,.4);
  color: #6ee7b7; font-size: 14px; text-align: center; font-weight: 600;
}
.ts-blocked-title { margin-top: 22px; font-size: 14px; color: #fde68a; font-weight: 600; }
.ts-blocked-hint { margin-top: 6px; font-size: 12.5px; color: rgba(255,255,255,.6); line-height: 1.6; }
</style>
</head>
<body>
<div class="orb o1"></div><div class="orb o2"></div><div class="orb o3"></div>

<div class="card" id="app">
  <div class="loading">
    <div class="spinner"></div>
    <div style="font-size:14px;color:rgba(255,255,255,.65)" id="loading-text"></div>
  </div>
</div>

<div class="brand"><span id="brand-text">Powered by <b>cloud-r2pan</b></span><button class="lang-btn" id="lang-toggle"></button></div>

<!-- GitHub Octocat 悬浮 -->
<a class="octo-float" href="https://github.com/Admin666pro/cloud-oauth2" target="_blank" rel="noopener noreferrer" title="GitHub">
  <!-- Octocat silhouette — GitHub 官方吉祥物 -->
  <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M12 .5C5.73.5.75 5.48.75 11.75c0 4.97 3.22 9.19 7.69 10.68.56.1.77-.24.77-.54 0-.27-.01-1.16-.02-2.11-3.13.68-3.79-1.34-3.79-1.34-.51-1.3-1.25-1.64-1.25-1.64-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.71 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.99 0 0 .95-.3 3.11 1.15.9-.25 1.87-.37 2.83-.37.96 0 1.93.12 2.83.37 2.16-1.45 3.11-1.15 3.11-1.15.61 1.56.23 2.71.11 2.99.72.79 1.16 1.8 1.16 3.03 0 4.33-2.64 5.28-5.14 5.56.4.34.76 1.02.76 2.07 0 1.5-.01 2.71-.01 3.08 0 .3.21.65.78.54 4.46-1.49 7.68-5.71 7.68-10.68C23.25 5.48 18.27.5 12 .5z"/>
  </svg>
</a>

<script>
/* ═══════════ i18n ═══════════ */
const I18N = {
  zh: {
    pageTitle: '分享 · {site}',
    loading: '正在加载分享信息…',
    notFoundTitle: '链接不存在', notFoundMsg: '该分享链接无效，或已被管理员删除。',
    goneTitle: '链接已失效', goneMsg: '该分享已被管理员撤销。',
    expiredTitle: '链接已过期', expiredMsg: '该分享已超过有效期，无法继续下载。',
    maxedTitle: '下载次数已达上限', maxedMsg: '该资源允许下载 {n} 次，名额已用完。',
    downloads: '下载次数', limit: '次数上限', size: '文件大小',
    download: '下载文件',
    protected: '🔒 该分享受密码保护',
    passwordPlaceholder: '输入访问密码', unlock: '解锁下载',
    unlockHint: '输入管理员提供的密码后即可开始下载',
    wrongPassword: '密码错误，请重试',
    shared: '{d} 分享', expires: '{d} 到期',
    quotaWarn: '⚠️ 本月流量已达预设限额，下载服务已临时暂停，请联系管理员。',
    hint: '下载由 {site} 提供 · 请勿重复下载',
    switchTo: 'EN',
    // Turnstile
    turnstileBlocked: '🛡️ 需要完成人机验证',
    turnstileHint: '该链接被管理员设为需要验证，请完成下方的人机检查后继续下载',
    turnstileLoading: '正在加载验证组件…',
    turnstilePass: '验证通过 ✓',
    turnstileFail: '验证失败，请重试',
    turnstileContinue: '继续下载',
    turnstileDownloadNow: '立即下载',
    // OAuth2
    oauthLogin: '使用 {provider} 登录',
    oauthLoggedInAs: '已登录 {provider}',
    oauthLogout: '退出',
    oauthContinueDownload: '继续下载',
    oauthHint: '该资源需要通过第三方账号验证后才能下载',
    oauthErrTitle: '登录失败',
    oauthErrMsg: 'OAuth 登录过程中出错了，请重试或换一个方式下载。',
    oauthRetry: '重试',
    oauthSkip: '跳过登录（可能被拒绝）',
    // 激活码
    codeLabel: '🎟️ 激活码（可选）',
    codePlaceholder: '输入 R2PAN-XXXX-XXXX-XXXX',
    codeHint: '使用激活码下载可绕过月度流量限额，享独立额度',
    codeCheck: '查询剩余额度',
    codeCheckOk: '剩余 {remaining} / 总 {total}',
    codeCheckInfinite: '剩余 ∞ (无限额度)',
    codeCheckBad: '查询失败：{msg}',
    codeRemove: '移除激活码',
  },
  en: {
    pageTitle: 'Share · {site}',
    loading: 'Loading share info…',
    notFoundTitle: 'Link Not Found', notFoundMsg: 'This share link is invalid or has been removed.',
    goneTitle: 'Link Revoked', goneMsg: 'This share has been revoked by the administrator.',
    expiredTitle: 'Link Expired', expiredMsg: 'This share has expired and is no longer available.',
    maxedTitle: 'Download Limit Reached', maxedMsg: 'This resource allows {n} downloads and the quota is used up.',
    downloads: 'Downloads', limit: 'Limit', size: 'File Size',
    download: 'Download',
    protected: '🔒 This share is password-protected',
    passwordPlaceholder: 'Enter access password', unlock: 'Unlock & Download',
    unlockHint: 'Enter the password provided by the administrator to download',
    wrongPassword: 'Incorrect password, please try again',
    shared: 'shared {d}', expires: 'expires {d}',
    quotaWarn: '⚠️ Monthly traffic quota reached. Downloads are temporarily paused. Please contact the administrator.',
    hint: 'Served by {site} · Please avoid duplicate downloads',
    switchTo: '中文',
    // Turnstile
    turnstileBlocked: '🛡️ Human verification required',
    turnstileHint: 'This link has been marked for verification. Please complete the check below to continue.',
    turnstileLoading: 'Loading verification widget…',
    turnstilePass: 'Verified ✓',
    turnstileFail: 'Verification failed, please retry',
    turnstileContinue: 'Continue download',
    turnstileDownloadNow: 'Download now',
    // OAuth2
    oauthLogin: 'Login with {provider}',
    oauthLoggedInAs: 'Logged in via {provider}',
    oauthLogout: 'Logout',
    oauthContinueDownload: 'Continue to Download',
    oauthHint: 'This resource requires third-party login to download',
    oauthErrTitle: 'Login Failed',
    oauthErrMsg: 'Something went wrong during OAuth login. Please retry.',
    oauthRetry: 'Retry',
    oauthSkip: 'Skip login (may be denied)',
    // Activation Codes
    codeLabel: '🎟️ Activation Code (optional)',
    codePlaceholder: 'Enter R2PAN-XXXX-XXXX-XXXX',
    codeHint: 'Using an activation code bypasses the monthly traffic quota with its own independent limit',
    codeCheck: 'Check Remaining',
    codeCheckOk: 'Remaining {remaining} / Total {total}',
    codeCheckInfinite: 'Remaining ∞ (unlimited)',
    codeCheckBad: 'Check failed: {msg}',
    codeRemove: 'Remove code',
  }
};

/** 语言检测：手动选择 > 浏览器首选语言 > 时区（大中华区） > 英文 */
function detectLang(){
  try {
    const saved = localStorage.getItem('cd_lang');
    if (saved === 'zh' || saved === 'en') return saved;
  } catch {}
  const first = String((navigator.languages && navigator.languages.length ? navigator.languages[0] : navigator.language) || '').toLowerCase();
  if (first.startsWith('zh')) return 'zh';
  if (first) return 'en';
  try {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    if (/^Asia\/(Shanghai|Chongqing|Harbin|Urumqi|Kashgar|Hong_Kong|Macau|Taipei)$/.test(tz)) return 'zh';
  } catch {}
  return 'en';
}

let LANG = detectLang();
const t = (key, params) => {
  let s = (I18N[LANG] && I18N[LANG][key]) ?? I18N.en[key] ?? key;
  if (params) for (const k in params) s = s.split('{' + k + '}').join(params[k]);
  return s;
};

document.documentElement.lang = LANG === 'zh' ? 'zh-CN' : 'en';
$('#loading-text').textContent = t('loading');
$('#lang-toggle').textContent = t('switchTo');
$('#lang-toggle').onclick = () => {
  try { localStorage.setItem('cd_lang', LANG === 'zh' ? 'en' : 'zh'); } catch {}
  location.reload();
};

function $(s){ return document.querySelector(s); }

/* ═══════════ 工具 ═══════════ */
const EXT_COLORS = {
  zip:'#ffb340', rar:'#ffb340', '7z':'#ffb340', tar:'#ffb340', gz:'#ffb340',
  pdf:'#ff6961', doc:'#5b9cf5', docx:'#5b9cf5', txt:'#9aa4b2', md:'#9aa4b2',
  xls:'#3ecf8e', xlsx:'#3ecf8e', csv:'#3ecf8e', ppt:'#ff9f0a', pptx:'#ff9f0a',
  mp3:'#bf5af2', wav:'#bf5af2', flac:'#bf5af2', m4a:'#bf5af2',
  mp4:'#ff453a', mov:'#ff453a', mkv:'#ff453a', avi:'#ff453a',
  png:'#30d158', jpg:'#30d158', jpeg:'#30d158', gif:'#30d158', webp:'#30d158', svg:'#30d158',
  apk:'#3ecf8e', exe:'#9aa4b2', iso:'#9aa4b2', dmg:'#9aa4b2', default:'#8ea0c8'
};
function extOf(name){ const m=/\.([a-z0-9]+)$/i.exec(name||''); return m?m[1].toLowerCase():''; }
function extColor(name){ return EXT_COLORS[extOf(name)]||EXT_COLORS.default; }
function fmtSize(n){
  if(!Number.isFinite(n))return '—';
  if(n<1024)return n+' B';
  const u=['KB','MB','GB','TB'];let i=-1;
  do{n/=1024;i++;}while(n>=1024&&i<u.length-1);
  return n.toFixed(n>=100?0:n>=10?1:2)+' '+u[i];
}
function fmtTime(ts){
  const d=new Date(ts),p=x=>String(x).padStart(2,'0');
  return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`;
}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

const token = location.pathname.split('/')[2];

let TURSTILE_LOADED = false, turnstileReady = false, pendingCb = null;
function loadTurnstileScript(onload){
  if(TURSTILE_LOADED){ if(window.turnstile){ window.turnstile.ready(cb=>{ turnstileReady = true; onload&&onload(cb); }); } return; }
  TURSTILE_LOADED = true;
  window.onTurnstileLoad = () => { turnstileReady = true; onload && onload(window.turnstile); };
  const s = document.createElement('script');
  s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad';
  s.async = true; s.defer = true;
  document.head.appendChild(s);
}

/**
 * 渲染 Turnstile widget 并等待完成。
 * 返回 Promise<string> —— token 字符串。
 */
async function renderTurnstile(containerEl, sitekey){
  containerEl.innerHTML = '<div class="ts-wrap"><div class="ts-box" data-sitekey="'+sitekey+'"></div></div>';
  loadTurnstileScript();
  // 等待 window.turnstile 出现
  await new Promise(resolve => {
    const check = () => { if(window.turnstile){ resolve(); } else { setTimeout(check, 80); } };
    check();
  });
  return await new Promise((resolve, reject) => {
    const id = window.turnstile.render(containerEl.querySelector('.ts-box'), {
      sitekey,
      theme: 'auto',
      callback: (tk) => resolve(tk),
      'error-callback': () => reject(new Error('ts_error')),
      'timeout-callback': () => reject(new Error('ts_timeout')),
    });
    containerEl.dataset.tsWidgetId = id;
  });
}

async function boot(){
  // OAuth callback 返回的错误参数 → 页面顶部提示
  const params = new URLSearchParams(location.search);
  const oauthErr = params.get('oauth_error');

  let info;
  let oauthProviders = [];
  try{
    const r = await fetch(`/s/${token}/info`, {cache:'no-store'});
    if(!r.ok) throw 0;
    info = await r.json();
  }catch{ renderError(t('notFoundTitle'), t('notFoundMsg')); return; }
  // 如果 OAuth2 启用了，拉启用中的 Provider 列表来渲染多个按钮
  if (info.oauth?.enabled) {
    try {
      const r2 = await fetch('/oauth/providers', {cache:'no-store'});
      if (r2.ok) {
        const j = await r2.json();
        oauthProviders = j.providers || [];
      }
    } catch {}
  }
  const siteName = info.site_title || 'cloud-r2pan';
  document.title = t('pageTitle', {site: siteName});
  $('#brand-text').innerHTML = `Powered by <b>${esc(siteName)}</b>`;
  render(info, siteName, oauthErr, oauthProviders);
}

function renderError(title,msg){
  $('#app').innerHTML = `
    <div class="file-icon" style="font-size:44px">🚫</div>
    <h1>${esc(title)}</h1>
    <div class="hint" style="margin-top:12px">${esc(msg)}</div>`;
}

function render(d, siteName, oauthErr, oauthProviders){
  const ext = extOf(d.name);
  const gone = {
    gone:[t('goneTitle'), t('goneMsg')],
    expired:[t('expiredTitle'), t('expiredMsg')],
    maxed:[t('maxedTitle'), t('maxedMsg', {n: d.max_downloads})]
  }[d.status];
  if(gone){ renderError(gone[0],gone[1]); return; }

  // Turnstile 判断：后端返回了 needs_now (on_share 模式已判断) 或 mode=on_download 时需要
  const ts = d.turnstile || {};
  const tsEnabled = ts.enabled && ts.sitekey;
  const tsOnShare = ts.mode === 'on_share' || ts.mode === 'both';
  const tsOnDownload = ts.mode === 'on_download' || ts.mode === 'both';
  const needTsNow = tsEnabled && ((tsOnShare && ts.needs_now) || (tsOnDownload));

  // OAuth2 判断（多 Provider）
  const oauth = d.oauth || {enabled:false, authed:false};
  const oauthEnabled = oauth.enabled && oauthProviders && oauthProviders.length > 0;
  const oauthAuthed = !!oauth.authed;

  const oauthErrHtml = oauthErr ? `
    <div class="warn">
      🔐 ${esc(t('oauthErrTitle'))}<br>
      <div style="margin-top:6px;font-size:12.5px;line-height:1.6">${esc(t('oauthErrMsg'))}</div>
    </div>` : '';

  // OAuth 登录按钮（每个 Provider 一个）
  const PROVIDER_ICONS = {
    github: '<svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor"><path d="M12 .5C5.73.5.75 5.48.75 11.75c0 4.97 3.22 9.19 7.69 10.68.56.1.77-.24.77-.54 0-.27-.01-1.16-.02-2.11-3.13.68-3.79-1.34-3.79-1.34-.51-1.3-1.25-1.64-1.25-1.64-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.71 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.99 0 0 .95-.3 3.11 1.15.9-.25 1.87-.37 2.83-.37.96 0 1.93.12 2.83.37 2.16-1.45 3.11-1.15 3.11-1.15.61 1.56.23 2.71.11 2.99.72.79 1.16 1.8 1.16 3.03 0 4.33-2.64 5.28-5.14 5.56.4.34.76 1.02.76 2.07 0 1.5-.01 2.71-.01 3.08 0 .3.21.65.78.54 4.46-1.49 7.68-5.71 7.68-10.68C23.25 5.48 18.27.5 12 .5z"/></svg>',
    google: '<svg viewBox="0 0 24 24" width="19" height="19"><path fill="#EA4335" d="M12 10.2v3.9h5.5c-.24 1.4-1.7 4.1-5.5 4.1-3.3 0-6-2.7-6-6.1s2.7-6.1 6-6.1c1.9 0 3.2.8 3.9 1.5l2.7-2.6C16.9 3 14.7 2 12 2 6.5 2 2 6.5 2 12s4.5 10 10 10c5.8 0 9.6-4.1 9.6-9.8 0-.7-.1-1.2-.2-1.7H12z"/></svg>',
    microsoft: '<svg viewBox="0 0 24 24" width="19" height="19"><rect x="2" y="2" width="10" height="10" fill="#F25022"/><rect x="12" y="2" width="10" height="10" fill="#7FBA00"/><rect x="2" y="12" width="10" height="10" fill="#00A4EF"/><rect x="12" y="12" width="10" height="10" fill="#FFB900"/></svg>',
    discord: '<svg viewBox="0 0 24 24" width="19" height="19" fill="#5865F2"><path d="M20.3 4.4A19.7 19.7 0 0 0 16.5 3l-.3.6a18 18 0 0 0-8.4 0L7.2 3c-1.3.2-2.6.8-3.8 1.4A20.3 20.3 0 0 0 1 17.6a20 20 0 0 0 6 3c.5-.6.9-1.3 1.3-2a12.8 12.8 0 0 1-2-.9c.2-.2.4-.3.5-.5a14.3 14.3 0 0 0 12.4 0c.2.2.4.3.5.5-.6.4-1.3.7-2 1 .4.7.8 1.4 1.3 2a20 20 0 0 0 6-3c.8-3 .6-6.1-.2-8.8zM8.1 14.5c-1 0-1.8-.9-1.8-2 0-1.1.8-2 1.8-2s1.8.9 1.8 2c0 1.1-.8 2-1.8 2zm7.8 0c-1 0-1.8-.9-1.8-2 0-1.1.8-2 1.8-2s1.8.9 1.8 2c0 1.1-.8 2-1.8 2z"/></svg>',
    custom: '<svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor"><path d="M12 1a11 11 0 1 0 0 22 11 11 0 0 0 0-22zm0 2a9 9 0 0 1 9 9c0 2.6-1.1 4.9-2.9 6.5-.7-1.4-2.1-2.3-3.7-2.3h-.5a5 5 0 0 0-3.5-1.4c-1.5 0-2.8.6-3.7 1.6A9 9 0 0 1 12 3zm0 5a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"/></svg>',
  };
  const oauthLoginBlock = oauthEnabled && !oauthAuthed && !d.quota_exceeded ? `
    <div class="oauth-block" style="margin-top:22px">
      <div style="font-size:13px;color:rgba(255,255,255,.6);margin-bottom:10px">${esc(t('oauthHint'))}</div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        ${oauthProviders.map(p => `
          <a class="btn" href="${p.start_url}&redirect=${encodeURIComponent(location.pathname)}" style="background:linear-gradient(180deg,#58a6ff,#1f6feb);display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:14px;text-decoration:none;font-size:13.5px;font-weight:500;color:#fff;box-shadow:0 6px 16px rgba(10,124,255,.3)">
            ${PROVIDER_ICONS[p.provider_type] || PROVIDER_ICONS.custom}
            ${esc(t('oauthLogin', {provider: p.label || p.name}))}
          </a>
        `).join('')}
      </div>
    </div>` : '';

  // OAuth 已登录状态（如果 fetch /oauth/session 显示已登录就渲染）
  const oauthAuthedBlock = oauthEnabled && oauthAuthed && !d.quota_exceeded ? `
    <div class="oauth-block" style="margin-top:22px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
        <div style="font-size:13px;color:#6ee7b7">✓ ${esc(t('oauthLoggedInAs', {provider: oauthProviders[0]?.label || 'OAuth'}))}</div>
        <button id="oauth-logout" style="background:none;border:none;color:rgba(255,255,255,.55);font-size:12px;cursor:pointer;padding:4px 8px;border-radius:8px">${esc(t('oauthLogout'))}</button>
      </div>
    </div>` : '';

  $('#app').innerHTML = `
    <div class="file-icon"><span class="ext" style="color:${extColor(d.name)}">${esc((ext||'FILE').toUpperCase())}</span></div>
    <h1>${esc(d.name)}</h1>
    <div class="meta">
      <span>${fmtSize(d.size)}</span>
      ${d.expires_at?`<span class="dot"></span><span>${esc(t('shared',{d:fmtTime(d.created_at)}))}</span><span class="dot"></span><span>${esc(t('expires',{d:fmtTime(d.expires_at)}))}</span>`
        :`<span class="dot"></span><span>${esc(t('shared',{d:fmtTime(d.created_at)}))}</span>`}
    </div>
    <div class="stats">
      <div class="stat"><div class="v">${d.downloads}</div><div class="k">${esc(t('downloads'))}</div></div>
      <div class="stat"><div class="v">${d.max_downloads??'∞'}</div><div class="k">${esc(t('limit'))}</div></div>
      <div class="stat"><div class="v">${fmtSize(d.size)}</div><div class="k">${esc(t('size'))}</div></div>
    </div>
    ${oauthErrHtml}
    ${oauthLoginBlock}
    ${oauthAuthedBlock}
    ${d.quota_exceeded?`<div class="warn">${esc(t('quotaWarn'))}</div>`:''}

    ${needTsNow && !d.quota_exceeded ? `
      <div class="ts-blocked-title">${esc(t('turnstileBlocked'))}</div>
      <div class="ts-blocked-hint">${esc(t('turnstileHint'))}</div>
      <div id="ts-container" style="margin-top:6px">${esc(t('turnstileLoading'))}</div>
    ` : ''}

    <!-- 激活码输入框（在密码框和下载按钮之前） -->
    <div id="code-box" style="margin-top:18px;display:flex;flex-direction:column;gap:6px">
      <div style="font-size:12.5px;color:rgba(255,255,255,.55)">${esc(t('codeLabel'))}</div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <input type="text" id="activation-code" placeholder="${esc(t('codePlaceholder'))}"
          style="flex:1;min-width:200px;padding:12px 16px;border-radius:14px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);color:#fff;font-size:14px;font-family:ui-monospace,'SF Mono',monospace;letter-spacing:.05em;outline:none"
          oninput="this.value=this.value.toUpperCase()">
        <button id="code-check" style="padding:10px 14px;border-radius:12px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;font-size:13px;cursor:pointer">${esc(t('codeCheck'))}</button>
        <button id="code-remove" style="display:none;padding:10px 14px;border-radius:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.6);font-size:12px;cursor:pointer">${esc(t('codeRemove'))}</button>
      </div>
      <div id="code-status" style="font-size:12px;color:rgba(255,255,255,.45);min-height:16px"></div>
    </div>

    ${d.needs_password && !d.quota_exceeded ? `
      <div class="pw" id="pw-box">
        <div class="pw-hint">${esc(t('protected'))}</div>
        <input type="password" id="pw" placeholder="${esc(t('passwordPlaceholder'))}" autocomplete="off" enterkeyhint="done">
        <div class="err" id="pw-err"></div>
        <a class="btn" id="pw-go" href="javascript:void(0)">
          <svg viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2"/></svg>
          ${esc(t('unlock'))}
        </a>
        <div class="pw-hint">${esc(t('unlockHint'))}</div>
      </div>`
      :`<a class="btn" id="dl" href="javascript:void(0)" ${d.quota_exceeded?'style="pointer-events:none;opacity:.45"':''} ${oauthEnabled && !oauthAuthed?'style="pointer-events:none;opacity:.45"':''}>
        <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v12m0 0l-4.5-4.5M12 15l4.5-4.5M4 20h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        ${esc(t('download'))}
      </a>
      <div class="hint">${esc(t('hint', {site: siteName}))}</div>`}
  `;

  // OAuth 登录/退出按钮绑定
  if(oauthEnabled){
    $('#oauth-logout')?.addEventListener('click', async () => {
      await fetch('/oauth/logout', {method:'POST', credentials:'same-origin'});
      location.reload();
    });
  }

  // 下载按钮绑定（OAuth 未登录时禁用）
  if(!d.needs_password && !d.quota_exceeded){
    $('#dl').onclick = () => {
      if(oauthEnabled && !oauthAuthed){
        // 跳转到第一个可用 Provider 的登录页
        const firstStart = oauthProviders[0]?.start_url;
        if (firstStart) {
          location.href = firstStart + '&redirect=' + encodeURIComponent(location.pathname);
        }
        return;
      }
      triggerDownload(d, ts, tsEnabled, tsOnDownload);
    };
  }

  if(d.needs_password && $('#pw')) wireUnlock(d, ts, tsEnabled, tsOnDownload, oauthEnabled, oauthAuthed, oauthProviders);

  // 激活码输入框事件绑定
  const codeInput = $('#activation-code');
  const codeCheckBtn = $('#code-check');
  const codeRemoveBtn = $('#code-remove');
  const codeStatus = $('#code-status');

  // 自动从 localStorage 恢复上次输入的激活码
  try {
    const saved = localStorage.getItem('r2pan_code');
    if(saved && codeInput){ codeInput.value = saved.toUpperCase(); if(codeRemoveBtn) codeRemoveBtn.style.display='inline-block'; }
  } catch {}

  if(codeInput){
    codeInput.addEventListener('input', () => {
      codeStatus.textContent = '';
      codeRemoveBtn.style.display = codeInput.value.trim() ? 'inline-block' : 'none';
    });
    codeInput.addEventListener('keydown', e => {
      if(e.key === 'Enter') { e.preventDefault(); codeCheckBtn?.click(); }
    });
    codeInput.addEventListener('change', () => {
      try { if(codeInput.value.trim()) localStorage.setItem('r2pan_code', codeInput.value.trim().toUpperCase()); else localStorage.removeItem('r2pan_code'); } catch {}
    });
  }
  if(codeRemoveBtn){
    codeRemoveBtn.addEventListener('click', () => {
      if(codeInput) { codeInput.value = ''; codeInput.focus(); }
      codeRemoveBtn.style.display = 'none';
      codeStatus.textContent = '';
      try { localStorage.removeItem('r2pan_code'); } catch {}
    });
  }
  if(codeCheckBtn){
    codeCheckBtn.addEventListener('click', async () => {
      const code = (codeInput?.value || '').trim().toUpperCase();
      if(!code) { codeStatus.textContent = t('codeCheckBad', {msg: 'code empty'}); return; }
      codeStatus.textContent = '...';
      try {
        const r = await fetch('/api/codes/status?code=' + encodeURIComponent(code));
        const d = await r.json();
        if(r.ok){
          const st = d.status || {};
          const rem = st.remaining;
          if(rem === -1) codeStatus.textContent = t('codeCheckInfinite');
          else {
            const fmt = n => { n = Number(n)||0; if(n<1024) return n+' B'; const u=['KB','MB','GB','TB']; let i=-1; do{n/=1024;i++;}while(n>=1024&&i<u.length-1); return n.toFixed(n>=100?0:n>=10?1:2)+' '+u[i]; };
            codeStatus.textContent = t('codeCheckOk', { remaining: fmt(rem), total: st.total>0?fmt(st.total):'∞' });
          }
          if(!d.usable && d.reason){ codeStatus.textContent += ' · ' + (d.message || d.reason); codeStatus.style.color = '#fbbf24'; }
          else codeStatus.style.color = '';
        } else {
          codeStatus.textContent = t('codeCheckBad', {msg: d.message||'not found'});
          codeStatus.style.color = '#f87171';
        }
      } catch(err){
        codeStatus.textContent = t('codeCheckBad', {msg: err.message});
        codeStatus.style.color = '#f87171';
      }
    });
  }

  // 如果 on_share 模式需要弹 Turnstile，现在就开始渲染
  if(needTsNow && tsOnShare && ts.sitekey){
    const box = $('#ts-container');
    renderTurnstile(box, ts.sitekey).then(tk => {
      box.innerHTML = `<div class="ts-passed">${esc(t('turnstilePass'))}</div>`;
      window.__tsToken = tk;
    }).catch(() => { box.innerHTML = `<div class="warn" style="text-align:center;font-size:12.5px">${esc(t('turnstileFail'))}</div>`; });
  }
}

async function triggerDownload(d, ts, tsEnabled, tsOnDownload){
  const baseUrl = `/s/${token}/download`;
  // 读取激活码
  const codeEl = $('#activation-code');
  const code = (codeEl?.value || '').trim().toUpperCase();
  // both / on_download 模式：先确保有 token
  if(tsEnabled && tsOnDownload){
    let tk = window.__tsToken;
    if(!tk){
      // 还没渲染过 → 现在渲染
      const box = document.createElement('div');
      box.style.cssText = 'margin-top:20px';
      document.body.appendChild(box);
      try{
        tk = await renderTurnstile(box, ts.sitekey);
        window.__tsToken = tk;
        box.remove();
      }catch{ box.remove(); return; }
    }
    let url = `${baseUrl}?cf=${tk}`;
    if(code) url += `&code=${encodeURIComponent(code)}`;
    location.href = url;
  } else {
    let url = baseUrl;
    if(code) url += `?code=${encodeURIComponent(code)}`;
    location.href = url;
  }
}

async function wireUnlock(d, ts, tsEnabled, tsOnDownload){
  const btn = $('#pw-go'), input = $('#pw'), err = $('#pw-err');
  const unlock = async () => {
    const pass = input.value;
    if(!pass) return;
    // 读取激活码
    const code = ($('#activation-code')?.value || '').trim().toUpperCase();
    btn.style.pointerEvents = 'none'; btn.style.opacity = '.6';
    err.textContent = '';
    // both 模式：需要 Turnstile token
    let turnstileToken = null;
    if(tsEnabled && ts.mode === 'both'){
      let tk = window.__tsToken;
      if(!tk){
        const box = document.createElement('div');
        box.style.cssText = 'margin-top:14px';
        document.getElementById('pw-box').appendChild(box);
        try{
          tk = await renderTurnstile(box, ts.sitekey);
          window.__tsToken = tk;
          box.innerHTML = `<div class="ts-passed">${esc(t('turnstilePass'))}</div>`;
        }catch(e){ box.remove(); err.textContent = t('turnstileFail'); btn.style.pointerEvents = ''; btn.style.opacity = ''; return; }
      }
      turnstileToken = tk;
    }
    try{
      const body = { password: pass };
      if(turnstileToken) body.turnstile = turnstileToken;
      const r = await fetch(`/s/${token}/verify`, { method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify(body) });
      let res = {};
      try{ res = await r.json(); }catch{}
      if(r.ok && res.url){
        // on_download 模式需要 cf 参数
        if(tsEnabled && tsOnDownload && !res.url.includes('cf=')){
          let tk = window.__tsToken;
          if(!tk){
            const box = document.createElement('div');
            box.style.cssText = 'margin-top:14px';
            document.getElementById('pw-box').appendChild(box);
            tk = await renderTurnstile(box, ts.sitekey);
            window.__tsToken = tk;
            box.innerHTML = `<div class="ts-passed">${esc(t('turnstilePass'))}</div>`;
          }
          const sep = res.url.includes('?') ? '&' : '?';
          let dlUrl = res.url + sep + 'cf=' + tk;
          if(code){ const s2 = dlUrl.includes('?') ? '&' : '?'; dlUrl += s2 + 'code=' + encodeURIComponent(code); }
          location.href = dlUrl;
        } else {
          let dlUrl = res.url;
          if(code){ const s2 = dlUrl.includes('?') ? '&' : '?'; dlUrl += s2 + 'code=' + encodeURIComponent(code); }
          location.href = dlUrl;
        }
        return;
      }
      err.textContent = t(res.error === 'bad_password' ? 'wrongPassword' : 'wrongPassword');
      $('#pw-box').classList.remove('shake'); void $('#pw-box').offsetWidth; $('#pw-box').classList.add('shake');
      input.select();
    }catch{
      err.textContent = t('wrongPassword');
    }
    btn.style.pointerEvents = ''; btn.style.opacity = '';
  };
  btn.onclick = unlock;
  input.addEventListener('keydown', e => { if(e.key === 'Enter') unlock(); });
}

boot();
</script>
</body>
</html>
